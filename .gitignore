# Root .gitignore for TechBuildding (Frontend + Backend)

# Frontend specific
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/.vscode/
Frontend/.idea/
Frontend/*.local

# Backend specific (Java/Spring Boot)
Backend/demoTechBuildding/target/
Backend/demoTechBuildding/.mvn/wrapper/maven-wrapper.jar
Backend/demoTechBuildding/.apt_generated
Backend/demoTechBuildding/.classpath
Backend/demoTechBuildding/.factorypath
Backend/demoTechBuildding/.project
Backend/demoTechBuildding/.settings
Backend/demoTechBuildding/build/
Backend/demoTechBuildding/mysql_data/

# Runtime data, local logs and generated storage must never be committed
**/minio_data/
**/redis_data/
**/repository/
**/*.log
**/backend-*.log
**/frontend-*.log

# Local reports and generated documentation are kept outside the source push
docs/
**/TechBuilding_Docs/
Backend/demoTechBuildding/HSNL_TechBuilder.pdf

# Temporary files created by local inspection/tools
=

# Global/Editor
.idea/
.vscode/
*.log
.DS_Store
*.swp
.env
__pycache__/
tmp/
audit_vietnamese.py
repair_vietnamese.py
run.bat
seed_data_expanded.sql
